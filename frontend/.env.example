# Public, non-secret settings only. Copy this file to ".env" and adjust ports if needed.
# Main API (verified running on port 8001)
VITE_API_BASE_URL=http://127.0.0.1:8001
# Monitoring API. In "npm run dev" the browser uses the Vite proxy (/monitoring-proxy),
# which forwards to this URL. In a production build the browser calls this URL directly,
# so it must be reachable and allow CORS (or be served same-origin).
VITE_MONITORING_API_BASE_URL=http://127.0.0.1:8010
