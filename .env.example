# Groq is optional; DATABASE_URL is required only for the separate Monitoring service.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:your_database_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require
MONITORING_URL=http://127.0.0.1:8010
MONITORING_TIMEOUT_SECONDS=0.5
GROQ_TIMEOUT_SECONDS=20
